# 収集ランナーが使うツールの版。対象リポジトリの設定に関係なく、この版で計測する。
# 版を上げるときは、トレンドに段差が出ないか（特に PMD の CC 算出）を確認する。
JACOCO_VERSION=0.8.15
# M-06（Java）。版を変えると CC の算出方法が変わりうる
PMD_VERSION=7.17.0
# 以下の 2 つは計測用のコンテナ（collector/runner/Dockerfile）にバイナリとして入れる
OASDIFF_VERSION=1.32.1
TRIVY_VERSION=0.74.0
# M-02。like-chatgpt の pom（-P mutation）と同じ版にそろえ、対象の CI の値と比べられるようにしている
PITEST_VERSION=1.20.4
PITEST_JUNIT5_VERSION=1.2.3
# 計測用のコンテナ（collector/runner/Dockerfile）に入れる Maven。対象に mvnw が無い場合だけ使う
MAVEN_VERSION=3.9.11
# M-03 / M-04 の負荷試験
K6_VERSION=1.8.0
