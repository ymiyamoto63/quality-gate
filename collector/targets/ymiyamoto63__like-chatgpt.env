# like-chatgpt の計測プロファイル（docs/operations/collector.md）
# 「どう測るか」だけを書く。合格ラインは quality-gate の画面（S-06）で設定する。
# KEY=VALUE の形式のみ。シェルとしては実行しない（値の引用符は外して読む）。

QG_REPOSITORY=ymiyamoto63/like-chatgpt
DEFAULT_BRANCH=main
# quality-gate の Actions Secrets のうち、このリポジトリの Ingest Token を入れたものの名前
INGEST_TOKEN_SECRET=QG_INGEST_TOKEN_LIKE_CHATGPT

# バックエンド（Maven）。空にするとバックエンドの計測（M-01 Java / M-07 / M-08）を行わない
BACKEND_DIR=backend
JAVA_VERSION=21
# M-08 に使う JUnit XML（BACKEND_DIR/target からの相対）。API を MockMvc で検証するテストだけを送る
CONTRACT_TEST_REPORTS=surefire-reports/TEST-*ControllerTest.xml

# M-02（PIT）の対象。空にすると M-02 を計測しない。PIT の引数と同じ書き方で、空白区切り。
# 既定ブランチの計測でだけ全量を実行し、PR などの計測では M-02 のスキップを申告する
# （画面の設定の execution.skippable_metrics に mutation_score が必要）。
# 対象の pom の -P mutation と同じ範囲にしている
MUTATION_TARGET_CLASSES=com.example.chatbackend.*
MUTATION_TARGET_TESTS=com.example.chatbackend.*
MUTATION_EXCLUDED_CLASSES=com.example.chatbackend.ChatBackendApplication com.example.chatbackend.config.*
MUTATION_EXCLUDED_TESTS=com.example.chatbackend.*IT
MUTATION_THREADS=2

# M-09 の OpenAPI 定義（リポジトリ相対）。コミットされている定義を比較する
OPENAPI_PATH=api/openapi.yml

# フロントエンド（npm + Vitest）。空にするとフロントエンドの計測（M-01 TS）を行わない
FRONTEND_DIR=frontend
NODE_VERSION_FILE=.nvmrc
# カバレッジの分母に含めるファイル（FRONTEND_DIR 相対、空白区切り。{ts,vue} のようにカンマを含むため）。
# 指定しないとテストが触れたファイルだけの数字になり、実態より良く見える
FRONTEND_COVERAGE_INCLUDE=src/**/*.{ts,vue}
FRONTEND_COVERAGE_EXCLUDE=src/**/*.spec.ts src/main.ts src/**/*.d.ts

# 定期実行（段階 2）。true にすると collect ワークフローが 15 分ごとに未計測の先頭コミットを探して計測する
SCHEDULE=true
# 同じリポジトリのブランチから出ている open な PR の先頭も計測する（フォークからの PR は計測しない）
MEASURE_PULL_REQUESTS=true

# 常にスキップを申告する指標（空白区切り）。PR での M-02 のように、計測の都合で申告するものは measure.sh が加える。
# 申告できるのは画面の設定で skippable_metrics に含めた指標だけ。
# 無効（enabled: false）にした指標はここに書かない
SKIP_METRICS=
