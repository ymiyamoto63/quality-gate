# 計測プロファイル（docs/operations.md 4.2）。quality-gate が見るアプリは 1 つだけで、ここにその測り方を書く。
# 合格ラインは quality-gate 側の環境変数（QG_*）で持ち、ここには書かない。
# 計測対象は ymiyamoto63/qg-test-target（タスク管理のサンプルアプリ）。このファイルの原本は qg-test-target の docs/quality-gate/profile.env
# KEY=VALUE の形式のみ。シェルとしては実行しない（値の引用符は外して読む）。

# 計測対象のリポジトリ。quality-gate の QG_REPOSITORY と同じ値にする（違うと取り込みで拒否される）
QG_REPOSITORY=ymiyamoto63/qg-test-target
# GitHub 上の既定ブランチ（main）と同じ値にする
DEFAULT_BRANCH=main

# 計測しない指標（指標 ID、空白区切り）。空なら 12 指標すべてを計測する。
# quality-gate の QG_DISABLED_METRICS（カンマ区切り）とそろえる。片方だけに書くと計測エラー（不合格）になる
DISABLED_METRICS=

# バックエンド（Maven）。M-01 Java / M-02 / M-06 Java / M-09 / M-10 を計測する。
# ここで作る jar は M-03 / M-04・M-08 でも起動する
BACKEND_DIR=backend
JAVA_VERSION=21
# M-09 / M-10 はすべてのテストの結果を送る。JUnit XML の場所は TEST_REPORTS（BACKEND_DIR/target からの相対、空白区切り）で
# 変えられる。省略時は surefire-reports/TEST-*.xml と failsafe-reports/TEST-*.xml

# M-02（PIT）の対象。PIT の引数と同じ書き方で、空白区切り。全量を実行する。
# 省略できるもの: MUTATION_TARGET_TESTS（既定は MUTATION_TARGET_CLASSES と同じ）、MUTATION_THREADS（既定 2）
MUTATION_TARGET_CLASSES=com.example.taskmanager.*
MUTATION_EXCLUDED_CLASSES=com.example.taskmanager.TaskManagerApplication com.example.taskmanager.config.*
MUTATION_EXCLUDED_TESTS=com.example.taskmanager.*IT

# M-07 の OpenAPI 定義（リポジトリ相対）。コミットされている定義を比較する
OPENAPI_PATH=api/openapi.yml

# フロントエンド（npm + Vitest）。M-01 TS / M-06 TS / M-09 / M-10 を計測する
FRONTEND_DIR=frontend
# リポジトリのルートからの相対。収集ランナーの measure-isolated.sh は $WORK/src/${NODE_VERSION_FILE} を読み、
# ファイルが無いと黙って 22 に落ちる。FRONTEND_DIR からの相対（.nvmrc）では読まれない
NODE_VERSION_FILE=frontend/.nvmrc
# カバレッジの分母に含めるファイル（FRONTEND_DIR 相対、空白区切り）。指定しないとテストが触れたファイルだけの数字になる
FRONTEND_COVERAGE_INCLUDE=src/**/*.{ts,vue}
FRONTEND_COVERAGE_EXCLUDE=src/**/*.spec.ts src/main.ts src/**/*.d.ts
# M-06（フロントエンド）の ESLint の設定と版は quality-gate 側のもの（collector/complexity）。
# 解析するディレクトリは FRONTEND_COMPLEXITY_SOURCES、解析しないファイルは FRONTEND_COMPLEXITY_EXCLUDE
# （FRONTEND_DIR 相対、空白区切り）で変えられる。省略時は src を、テスト（*.spec.ts / *.test.ts）と型定義を除いて解析する

# M-08（アクセシビリティ）。バックエンドの jar と vite preview を起動し、ここに書いた画面をライト・ダークで検査する。
# 検査する画面のパス（空白区切り）。quality-gate の QG_ACCESSIBILITY_PAGES（カンマ区切り）と一致させる
A11Y_PAGES=/
# 描画が済んだと判断できる要素（CSS セレクタ）
A11Y_READY_SELECTOR=h1
# バックエンドを起動するポート。frontend/vite.config.ts の /api の proxy 先（localhost:8080）に合わせる
A11Y_BACKEND_PORT=8080

# M-03 / M-04（性能）。バックエンドの jar を起動し、collector/target/ にある k6 のシナリオで負荷をかける（1 回あたり約 6 分）。
# バックエンドを起動するポート（PERF_BACKEND_PORT）の既定は 8080、実行回数（PERF_RUNS。中央値で判定し、3 回未満は計測エラー）の既定は 3 回
PERF_SCRIPT=k6.js
# 計測環境の名前。前回値を比べる単位になる。ランナーのマシンや計測条件を変えたら名前も変える
PERF_ENVIRONMENT=collector-container
# シードデータの名前（Flyway の V2 が投入する固定データ）
PERF_DATASET_PROFILE=flyway-seed-v2
