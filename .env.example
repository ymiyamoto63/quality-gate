# ログイン用の GitHub App
QG_GITHUB_CLIENT_ID=
QG_GITHUB_CLIENT_SECRET=

# データベース
QG_DB_URL=jdbc:postgresql://localhost:5432/qualitygate
QG_DB_USERNAME=qualitygate
QG_DB_PASSWORD=qualitygate

# 成果物ストア（ローカルファイルシステム）
QG_ARTIFACT_ROOT=./data/artifacts

# 収集ランナーが取り込み API に送るトークン（例: openssl rand -hex 32 で作る）。
# 交換するときは新旧をカンマ区切りで並べ、収集ランナー側を切り替えてから古い値を消す
QG_INGEST_TOKEN=

# 以下は任意。使うときはコメントを外す（空の値を書くと起動に失敗するものがある）
# 画面の URL（取り込み API の応答に載せる Run 詳細のリンクに使う）
# QG_BASE_URL=http://localhost:8080
# データ保持期間（日）
# QG_RETENTION_RUN_DAYS=730
# QG_RETENTION_ARTIFACT_DAYS=90
# QG_RETENTION_AUDIT_LOG_DAYS=730
# 日次バッチとリリース判定の日付に使うタイムゾーン
# QG_SCHEDULE_ZONE=Asia/Tokyo
# ログの形式。ecs / logstash / gelf で 1 行 1 JSON（未指定ならテキスト）
# QG_LOG_FORMAT=ecs
