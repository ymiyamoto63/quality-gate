# ===== 必須（この 3 つだけ書けば起動できる） =====

# 計測対象のリポジトリ（owner/name）。quality-gate は 1 つのアプリだけを見る。
# 収集ランナーは、これと同じ QG_REPOSITORY の計測プロファイル（collector/targets/*/profile.env）で計測する。
# 対象を切り替えるときはここだけを変える
QG_REPOSITORY=ymiyamoto63/like-chatgpt

# 画面のログインのパスワード（全員で共有する 1 つのアカウント。12 文字以上。例: openssl rand -base64 18 で作る）。
# ユーザー名は QG_LOGIN_USERNAME（既定 quality）
QG_LOGIN_PASSWORD=

# 収集ランナーが取り込み API に送るトークン（例: openssl rand -hex 32 で作る）。
# quality-gate リポジトリの Actions の Secret QG_INGEST_TOKEN にも同じ値を入れる。
# 交換するときは新旧をカンマ区切りで並べ、Secret を切り替えてから古い値を消す
QG_INGEST_TOKEN=

# ===== 計測対象に合わせる値（合格ライン。docs/metrics.md）=====
# 書かなければ既定値。変えた値は、その後に判定する計測から効く

# 判定しない指標（カンマ区切り）。収集ランナーも計測しない。like-chatgpt は負荷試験（M-03 / M-04）を止めている
QG_DISABLED_METRICS=M-03,M-04
# 計測から除くファイル（glob、カンマ区切り）
QG_EXCLUSIONS=**/ChatBackendApplication.java,**/main.ts,**/*.d.ts,**/*.config.ts
QG_MUTATION_COMPONENTS=backend
QG_PERF_SCENARIOS=chat,suggest,monitoring
# M-08 で検査されているべき画面（カンマ区切り）。収集ランナーはこの画面を検査する
QG_ACCESSIBILITY_PAGES=/
# QG_BRANCH_COVERAGE_MIN=75
# QG_MUTATION_SCORE_MIN=60
# QG_RESPONSE_TIME_P95_MAX_MS=500
# QG_ARRIVAL_RATE_RPS=50
# QG_ERROR_RATE_MAX_PCT=0.1
# QG_CRITICAL_VULNERABILITIES_MAX=0
# QG_HIGH_VULNERABILITIES_MAX=0
# QG_COMPLEXITY_MAX=15
# QG_BREAKING_CHANGES_MAX=0
# QG_ACCESSIBILITY_VIOLATIONS_MAX=0
# QG_TEST_SUCCESS_RATE_MIN=100
# QG_TEST_COUNT_MIN=1
# QG_SKIPPED_TESTS_INCREASE_MAX=0
# QG_SECRETS_MAX=0
# QG_FORBIDDEN_LICENSES_MAX=0

# ===== 任意（既定値のままでよければ書かない）=====
# ログインのユーザー名
# QG_LOGIN_USERNAME=quality
# データベース（既定値は compose.yaml の db と同じ。docker compose --profile full ではコンテナ用の値で上書きされる）
# QG_DB_URL=jdbc:postgresql://localhost:5432/qualitygate
# QG_DB_USERNAME=qualitygate
# QG_DB_PASSWORD=qualitygate
# 成果物ストア（ローカルファイルシステム）
# QG_ARTIFACT_ROOT=./data/artifacts
# 画面の URL（取り込み API の応答に載せるリリース判定のリンクに使う）
# QG_BASE_URL=http://localhost:8080
# ログの形式。ecs / logstash / gelf で 1 行 1 JSON（未指定ならテキスト）
# QG_LOG_FORMAT=ecs
