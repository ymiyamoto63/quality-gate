# GitHub App（OAuth / Contents 読み取り）
QG_GITHUB_CLIENT_ID=
QG_GITHUB_CLIENT_SECRET=

# データベース
QG_DB_URL=jdbc:postgresql://localhost:5432/qualitygate
QG_DB_USERNAME=qualitygate
QG_DB_PASSWORD=qualitygate

# 成果物ストア（ローカルファイルシステム）
QG_ARTIFACT_ROOT=./data/artifacts

# メール通知（任意）。未設定ならメールは送らない
QG_SMTP_HOST=
QG_SMTP_PORT=25
QG_SMTP_USERNAME=
QG_SMTP_PASSWORD=
QG_MAIL_FROM=quality-gate@localhost
