#!/usr/bin/env bash
# quality-gate の Ingest API に計測結果を送る CLI（FR-03-5）。
#
# Run の作成 → 成果物のアップロード → finalize を 1 回の呼び出しで行う。GitHub Actions 以外の CI からも使える。
# GitHub Actions では、これを包んだ quality-gate-action（FR-03-4）を使うと引数を自動で埋められる。
# 仕様: docs/operations/ci-submit.md
#
# 必要なもの: bash 4 以上、curl、jq
#
# 使い方:
#   qg-submit --url https://qg.example.com --repository owner/name --commit <40 桁の SHA> --branch main \
#     --runner-type self-hosted \
#     --config .quality-gate.yml \
#     --artifact jacoco-xml=backend/target/site/jacoco/jacoco.xml --component backend \
#     --artifact 'junit-xml=reports/contract/TEST-*.xml' --component backend \
#     --artifact pit-xml=reports/mutations.xml --metadata '{"mutationScope":"all"}' \
#     --skip 'M-03=負荷試験の環境が無いため'
#
# 引数（--artifact の後の --component / --scope / --metadata は、直前の --artifact に付く）:
#   --url URL              quality-gate の URL（既定: 環境変数 QG_BASE_URL）
#   --token TOKEN          Ingest Token（既定: 環境変数 QG_INGEST_TOKEN。引数で渡すとプロセス一覧に出るため環境変数を勧める）
#   --repository OWNER/NAME  必須
#   --commit SHA           必須（40 桁）
#   --branch NAME          必須
#   --runner-type TYPE     必須（self-hosted / github-hosted）
#   --base-commit SHA      比較元のコミット（40 桁）
#   --pull-request N       PR の番号
#   --triggered-by TEXT    起動のきっかけ（既定: ci）
#   --ci-run-url URL       CI の実行の URL
#   --measured-at TIME     計測日時（ISO 8601。既定: 現在）
#   --config FILE          .quality-gate.yml を quality-gate-config として送る
#   --artifact TYPE=PATH   成果物。PATH はグロブ可（一致したファイルを 1 つずつ送る）。何度でも指定できる
#     --component NAME     直前の成果物のコンポーネント
#     --scope head|base    直前の成果物のスコープ
#     --metadata JSON      直前の成果物のメタデータ
#   --skip ID=REASON       計測しなかった指標（例: M-02=PR では実行しない）。何度でも指定できる
#   --allow-missing        成果物のファイルが無くても失敗にしない（警告にとどめる。未提出の指標は quality-gate が ERROR にする）
#   --no-finalize          finalize しない（成果物を後から足す場合）
#   --wait SECONDS         finalize の後、判定が終わるまで最大 SECONDS 秒待って結果を表示する
#   --github-output FILE   run-id / verdict / status を GitHub Actions の出力形式で書く
#
# 終了コード: 0 成功 / 1 送信の失敗（API のエラー） / 2 引数の誤り / 3 待機中に判定が終わらなかった
set -euo pipefail

err() { echo "qg-submit: $*" >&2; }
usage() { err "$1"; err "使い方は qg-submit の先頭のコメントを参照してください"; exit 2; }

URL=${QG_BASE_URL:-}
TOKEN=${QG_INGEST_TOKEN:-}
REPOSITORY="" COMMIT="" BRANCH="" RUNNER_TYPE="" BASE_COMMIT="" PR="" TRIGGERED_BY=ci CI_RUN_URL="" MEASURED_AT=""
CONFIG="" ALLOW_MISSING=0 FINALIZE=1 WAIT=0 GITHUB_OUTPUT_FILE=""
TYPES=() PATHS=() COMPONENTS=() SCOPES=() METADATA=()
SKIPS=()

need() { [ $# -ge 2 ] && [ -n "$2" ] || usage "$1 に値がありません"; }
last() { [ ${#TYPES[@]} -gt 0 ] || usage "$1 は --artifact の後に指定してください"; echo $((${#TYPES[@]} - 1)); }

while [ $# -gt 0 ]; do
  case "$1" in
    --url) need "$@"; URL=$2; shift 2 ;;
    --token) need "$@"; TOKEN=$2; shift 2 ;;
    --repository) need "$@"; REPOSITORY=$2; shift 2 ;;
    --commit) need "$@"; COMMIT=$2; shift 2 ;;
    --branch) need "$@"; BRANCH=$2; shift 2 ;;
    --runner-type) need "$@"; RUNNER_TYPE=$2; shift 2 ;;
    --base-commit) [ $# -ge 2 ] || usage "$1 に値がありません"; BASE_COMMIT=$2; shift 2 ;;
    --pull-request) [ $# -ge 2 ] || usage "$1 に値がありません"; PR=$2; shift 2 ;;
    --triggered-by) need "$@"; TRIGGERED_BY=$2; shift 2 ;;
    --ci-run-url) [ $# -ge 2 ] || usage "$1 に値がありません"; CI_RUN_URL=$2; shift 2 ;;
    --measured-at) need "$@"; MEASURED_AT=$2; shift 2 ;;
    --config) [ $# -ge 2 ] || usage "$1 に値がありません"; CONFIG=$2; shift 2 ;;
    --artifact)
      need "$@"
      [[ "$2" == *=* ]] || usage "--artifact は TYPE=PATH の形で指定してください: $2"
      TYPES+=("${2%%=*}"); PATHS+=("${2#*=}"); COMPONENTS+=(""); SCOPES+=(""); METADATA+=("")
      shift 2 ;;
    --component) need "$@"; i=$(last "$1") || exit 2; COMPONENTS[i]=$2; shift 2 ;;
    --scope) need "$@"; i=$(last "$1") || exit 2; SCOPES[i]=$2; shift 2 ;;
    --metadata)
      need "$@"; i=$(last "$1") || exit 2
      jq -e 'type == "object"' <<< "$2" >/dev/null 2>&1 || usage "--metadata は JSON のオブジェクトで指定してください: $2"
      METADATA[i]=$2; shift 2 ;;
    --skip)
      need "$@"
      [[ "$2" == *=* ]] || usage "--skip は ID=REASON の形で指定してください: $2"
      SKIPS+=("$2"); shift 2 ;;
    --allow-missing) ALLOW_MISSING=1; shift ;;
    --no-finalize) FINALIZE=0; shift ;;
    --wait) need "$@"; [[ "$2" =~ ^[0-9]+$ ]] || usage "--wait は秒数で指定してください: $2"; WAIT=$2; shift 2 ;;
    --github-output) need "$@"; GITHUB_OUTPUT_FILE=$2; shift 2 ;;
    -h|--help) sed -n '2,/^set -euo/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) usage "解釈できない引数です: $1" ;;
  esac
done

command -v curl >/dev/null || { err "curl がありません"; exit 2; }
command -v jq >/dev/null || { err "jq がありません"; exit 2; }
[ -n "$URL" ] || usage "--url（または QG_BASE_URL）が必要です"
[ -n "$TOKEN" ] || usage "--token（または QG_INGEST_TOKEN）が必要です"
[[ "$REPOSITORY" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || usage "--repository は owner/name の形で指定してください"
[[ "$COMMIT" =~ ^[0-9a-f]{40}$ ]] || usage "--commit は 40 桁の SHA で指定してください"
[ -z "$BASE_COMMIT" ] || [[ "$BASE_COMMIT" =~ ^[0-9a-f]{40}$ ]] || usage "--base-commit は 40 桁の SHA で指定してください"
[ -n "$BRANCH" ] || usage "--branch が必要です"
case "$RUNNER_TYPE" in self-hosted|github-hosted) ;; *) usage "--runner-type は self-hosted か github-hosted です" ;; esac
[ -z "$PR" ] || [[ "$PR" =~ ^[1-9][0-9]*$ ]] || usage "--pull-request は番号で指定してください"
[ -z "$CONFIG" ] || [ -f "$CONFIG" ] || usage "設定ファイルがありません: $CONFIG"

# 成果物のグロブを先に展開する（Run を作ってから「ファイルが無い」で止まらないように）
FILES=() FILE_INDEX=() missing=0
for i in "${!TYPES[@]}"; do
  matched=0
  while IFS= read -r file; do
    [ -f "$file" ] || continue
    FILES+=("$file"); FILE_INDEX+=("$i"); matched=1
  done < <(compgen -G "${PATHS[i]}" || true)
  if [ "$matched" -eq 0 ]; then
    err "成果物がありません（type=${TYPES[i]}）: ${PATHS[i]}"
    missing=1
  fi
done
if [ "$missing" -eq 1 ] && [ "$ALLOW_MISSING" -eq 0 ]; then
  err "無い成果物を未提出のまま送るなら --allow-missing を付けてください"
  exit 2
fi

API="${URL%/}/api/v1/runs"
CURL=(curl -sS --retry 3 --retry-connrefused --connect-timeout 10 -H "Authorization: Bearer ${TOKEN}")

# call <説明> <curl の引数...>。失敗したら API のエラー（code / message）を出して終了する
call() {
  local what=$1 body status
  shift
  body=$(mktemp)
  status=$("${CURL[@]}" -o "$body" -w '%{http_code}' "$@") || { err "${what}: quality-gate に接続できませんでした（$URL）"; rm -f "$body"; exit 1; }
  if [ "$status" -lt 200 ] || [ "$status" -ge 300 ]; then
    # エラーは RFC 9457 の形（errorCode / detail、入力の誤りは violations）で返る
    local message
    message=$(jq -r '[.errorCode, .detail] | map(select(. != null)) | join(": ")' "$body" 2>/dev/null || head -c 500 "$body")
    if [ -z "$message" ]; then
      case "$status" in
        401) message="Ingest Token が無効です（失効・取り違え・未設定を確認してください）" ;;
        404) message="見つかりません（URL、または Run の ID を確認してください）" ;;
        *) message="応答に本文がありません" ;;
      esac
    fi
    err "${what}に失敗しました（HTTP $status）: $message"
    jq -r '.violations[]? | "  - \(.field): \(.message)"' "$body" 2>/dev/null >&2 || true
    rm -f "$body"
    exit 1
  fi
  cat "$body"
  rm -f "$body"
}

skipped_json() {
  local entry
  for entry in "${SKIPS[@]}"; do
    jq -n --arg id "${entry%%=*}" --arg reason "${entry#*=}" '{metricId: $id, reason: $reason}'
  done | jq -s .
}

REQUEST=$(jq -n \
  --arg repository "$REPOSITORY" --arg commitSha "$COMMIT" --arg branch "$BRANCH" \
  --arg runnerType "$RUNNER_TYPE" --arg triggeredBy "$TRIGGERED_BY" \
  --arg measuredAt "${MEASURED_AT:-$(date -u +%FT%TZ)}" \
  --arg baseCommitSha "$BASE_COMMIT" --arg pr "$PR" --arg ciRunUrl "$CI_RUN_URL" \
  --argjson skippedMetrics "$(skipped_json)" \
  '{repository: $repository, commitSha: $commitSha, branch: $branch, runnerType: $runnerType,
    triggeredBy: $triggeredBy, measuredAt: $measuredAt}
   + (if ($skippedMetrics | length) > 0 then {skippedMetrics: $skippedMetrics} else {} end)
   + (if $baseCommitSha != "" then {baseCommitSha: $baseCommitSha} else {} end)
   + (if $pr != "" then {pullRequestNumber: ($pr | tonumber)} else {} end)
   + (if $ciRunUrl != "" then {ciRunUrl: $ciRunUrl} else {} end)')

RUN_ID=$(call "Run の作成" -X POST "$API" -H 'Content-Type: application/json' -d "$REQUEST" | jq -r '.runId')
echo "Run を作成しました: $RUN_ID"
output() { [ -z "$GITHUB_OUTPUT_FILE" ] || echo "$1=$2" >> "$GITHUB_OUTPUT_FILE"; }
output run-id "$RUN_ID"

# upload <type> <file> [component] [scope] [metadata]
upload() {
  local type=$1 file=$2 component=${3:-} scope=${4:-} metadata=${5:-} query
  query="type=$(jq -rn --arg v "$type" '$v | @uri')"
  [ -z "$component" ] || query+="&component=$(jq -rn --arg v "$component" '$v | @uri')"
  [ -z "$scope" ] || query+="&scope=$(jq -rn --arg v "$scope" '$v | @uri')"
  local form=(-F "file=@${file}")
  [ -z "$metadata" ] || form+=(-F "metadata=${metadata}")
  call "成果物の送信（type=$type, $file）" -X POST "${API}/${RUN_ID}/artifacts?${query}" "${form[@]}" >/dev/null
  echo "送信しました: type=$type ${component:+component=$component }${scope:+scope=$scope }$file"
}

[ -z "$CONFIG" ] || upload quality-gate-config "$CONFIG"
for n in "${!FILES[@]}"; do
  i=${FILE_INDEX[n]}
  upload "${TYPES[i]}" "${FILES[n]}" "${COMPONENTS[i]}" "${SCOPES[i]}" "${METADATA[i]}"
done

if [ "$FINALIZE" -eq 0 ]; then
  echo "finalize していません（--no-finalize）。成果物を送り終えたら POST ${API}/${RUN_ID}/finalize を呼んでください"
  exit 0
fi
call "finalize" -X POST "${API}/${RUN_ID}/finalize" >/dev/null
echo "finalize しました。判定は quality-gate で非同期に行われます: ${URL%/}/runs/${RUN_ID}"

[ "$WAIT" -gt 0 ] || exit 0
deadline=$((SECONDS + WAIT))
while :; do
  status_json=$(call "判定状況の取得" "${API}/${RUN_ID}/status")
  status=$(jq -r '.status' <<< "$status_json")
  case "$status" in
    EVALUATED|FAILED|ABANDONED)
      verdict=$(jq -r '.verdict // empty' <<< "$status_json")
      echo "判定: status=$status${verdict:+ verdict=$verdict}"
      output status "$status"
      output verdict "$verdict"
      exit 0 ;;
  esac
  if [ "$SECONDS" -ge "$deadline" ]; then
    err "${WAIT} 秒待っても判定が終わりませんでした（status=$status）"
    output status "$status"
    exit 3
  fi
  sleep 2
done
